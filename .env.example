# ===================== App =====================
APP_NAME=VectorHire
APP_ENV=development            # development | production | test
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# JSON list (required format for pydantic-settings)
CORS_ORIGINS=["http://localhost:5173"]

# ===================== MongoDB =====================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vectorhire

# ===================== Auth =====================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===================== Storage =====================
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
FAISS_DIR=./data/faiss
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=15

# ===================== OCR =====================
# Leave blank if tesseract is on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANG=eng
OCR_DPI=300
# A page with fewer extracted characters than this is sent to OCR
OCR_MIN_CHARS_PER_PAGE=80

# ===================== Chunking =====================
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# ===================== Embeddings =====================
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu           # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=1024
# BGE recommends this prefix for retrieval queries (not for passages)
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# ===================== Retrieval =====================
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.30

# ===================== LLM =====================
LLM_PROVIDER=anthropic         # anthropic | openai
LLM_MODEL=claude-sonnet-5-5    # e.g. gpt-4o-mini when LLM_PROVIDER=openai
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===================== Hybrid scoring weights (must sum to 1.0) =====================
SCORE_WEIGHT_SEMANTIC=0.30
SCORE_WEIGHT_SKILL=0.20
SCORE_WEIGHT_COVERAGE=0.30
SCORE_WEIGHT_LLM=0.20

# ===================== Agent / guardrails =====================
AGENT_MAX_RETRIES=2
GUARDRAIL_MIN_EVIDENCE_OVERLAP=0.5